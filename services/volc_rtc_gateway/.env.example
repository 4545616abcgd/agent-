# Long-lived secrets. Keep these on the gateway only.
RTC_APP_ID=
RTC_APP_KEY=
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=

# VoiceChat runtime services. These are separate from the RTC and OpenAPI keys.
ASR_APP_ID=
ASR_ACCESS_TOKEN=
TTS_APP_ID=
TTS_ACCESS_TOKEN=
ARK_ENDPOINT_ID=

# Provision this value to the device separately. Use at least 24 random characters.
DEVICE_API_KEY=

# LAN development defaults. Use 0.0.0.0 so an ESP32 on the same Wi-Fi can connect.
HOST=0.0.0.0
PORT=8080

# Optional settings.
RTC_BUSINESS_ID=
RTC_SESSION_TTL_SECONDS=3600
VOICE_CHAT_CONFIG_PATH=./config/voice_chat.json
